{
  "name": "curious-minds",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first arcade of quick brain games: wordplay, world knowledge and connections.",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:artifact": "bun scripts/build.ts --artifact",
    "geo": "bun scripts/build-geo.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && bun test && bun scripts/build.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
